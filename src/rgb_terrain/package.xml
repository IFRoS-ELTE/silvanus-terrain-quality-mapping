<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgb_terrain</name>
  <version>0.1.0</version>
  <description>RGB terrain classifier publishing the surface type on /ground/rgb_terrain.</description>
  <maintainer email="myamin.bcss19@iba-suk.edu.pk">Muhammad Yamin</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- onnxruntime comes from pip, installed by the Dockerfile for the crack node. -->
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
