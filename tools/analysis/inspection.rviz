Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.25
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Ground photo
      Enabled: true
      Topic:
        Value: /inspection/ground
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Boxes
      Size (m): 0.021
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Route
      Enabled: true
      Topic:
        Value: /inspection/route
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Line Style: Billboards
      Line Width: 0.03
      Color: 245; 245; 245
      Alpha: 0.6
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Hazards
      Enabled: true
      Topic:
        Value: /inspection/hazards
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Namespaces:
        hazards: true
        labels: true
        priority: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 41; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 16
      Focal Point:
        X: 8
        Y: -8
        Z: 0
      Pitch: 0.75
      Yaw: 3.9
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
